    {
      "name": "CREATE USER",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.collectionVariables.set(\"userId\", response.id);\r",
              "\r",
              "pm.test(\"User id exists\", function () {\r",
              "    pm.expect(response.id).to.exist;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"arman\",\r\n  \"firstName\": \"Arman\",\r\n  \"lastName\": \"Shakhanov\",\r\n  \"email\": \"arman@postman.test\",\r\n  \"phone\": \"77771234567\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
