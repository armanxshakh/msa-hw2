    {
      "name": "Check User 1 profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log(\"RESPONSE:\", pm.response.text());\r\n\r\npm.test(\"User 1 profile returned\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Updated profile data persisted\", function () {\r\n    pm.expect(response.firstName).to.eql(\"Arman Updated\");\r\n    pm.expect(response.lastName).to.eql(\"User1 Updated\");\r\n    pm.expect(response.email).to.eql(\r\n        \"updated_\" + pm.collectionVariables.get(\"runId\") + \"@test.com\"\r\n    );\r\n    pm.expect(response.phone).to.eql(\"77779999999\");\r\n});\r\n\r\npm.test(\"Correct user returned\", function () {\r\n    pm.expect(String(response.id)).to.eql(\r\n        String(pm.collectionVariables.get(\"user1Id\"))\r\n    );\r\n});"
            ]
          }
        }
