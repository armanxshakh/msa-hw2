            "exec": [
              "const runId = Date.now();\r\n\r\npm.collectionVariables.set(\"runId\", runId);\r\n\r\npm.collectionVariables.set(\"user1Username\", \"user1_\" + runId);\r\npm.collectionVariables.set(\"user1Email\", \"user1_\" + runId + \"@test.com\");\r\npm.collectionVariables.set(\"user1Password\", \"Password123!\");\r\n\r\npm.collectionVariables.set(\"user2Username\", \"user2_\" + runId);\r\npm.collectionVariables.set(\"user2Email\", \"user2_\" + runId + \"@test.com\");\r\npm.collectionVariables.set(\"user2Password\", \"Password123!\");\r\n\r\npm.collectionVariables.unset(\"user1Id\");\r\npm.collectionVariables.unset(\"user2Id\");\r\npm.collectionVariables.unset(\"token1\");\r\npm.collectionVariables.unset(\"token2\");"
            ]
