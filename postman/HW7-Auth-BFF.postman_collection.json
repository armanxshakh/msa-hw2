    {
      "name": "Update User 1 profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log(\"REQUEST:\", pm.request.body.raw);\r\nconsole.log(\"RESPONSE:\", pm.response.text());\r\n\r\npm.test(\"User 1 profile updated\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Profile data updated\", function () {\r\n    pm.expect(response.firstName).to.eql(\"Arman Updated\");\r\n    pm.expect(response.lastName).to.eql(\"User1 Updated\");\r\n    pm.expect(response.email).to.eql(\r\n        \"updated_\" + pm.collectionVariables.get(\"runId\") + \"@test.com\"\r\n    );\r\n    pm.expect(response.phone).to.eql(\"77779999999\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token1}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstName\": \"Arman Updated\",\r\n  \"lastName\": \"User1 Updated\",\r\n  \"email\": \"updated_{{runId}}@test.com\",\r\n  \"phone\": \"77779999999\"\r\n}",
