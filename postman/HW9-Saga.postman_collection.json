  "item": [
    {
      "name": "1. Register unique user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "protocol": "http",
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "Creates a unique user and initializes unique test data for this Newman run.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"firstName\": \"Arman\",\n  \"lastName\": \"Saga\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"77770000009\",\n  \"password\": \"Password123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = Date.now().toString();",
              "const randomPart = Math.floor(Math.random() * 10000).toString().padStart(4, '0');",
              "const runId = now + randomPart;",
              "pm.collectionVariables.set('runId', runId);",
              "pm.collectionVariables.set('username', 'saga_' + runId);",
              "pm.collectionVariables.set('email', 'saga_' + runId + '@test.com');",
              "",
              "// Numeric IDs are kept safely inside Java Long / JS safe integer range.",
              "const numericBase = Number(now.slice(-8)) * 10 + Number(randomPart.slice(-1));",
              "pm.collectionVariables.set('productId', String(numericBase));",
              "pm.collectionVariables.set('missingProductId', String(numericBase + 1));",
              "",
              "pm.collectionVariables.set('successSlot', 'success-' + runId);",
              "pm.collectionVariables.set('deliveryFailureSlot', 'delivery-fail-' + runId);",
              "pm.collectionVariables.set('warehouseFailureSlot', 'warehouse-fail-' + runId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('1. User created: HTTP 201', function () { pm.response.to.have.status(201); });",
              "const j = pm.response.json();",
              "pm.test('1. User id returned', function () { pm.expect(j.id).to.exist; });",
              "pm.test('1. Username is unique run username', function () {",
              "    pm.expect(j.username).to.eql(pm.collectionVariables.get('username'));",
              "});",
              "pm.collectionVariables.set('userId', String(j.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Wait for billing account and deposit 1000",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://{{baseUrl}}/billing/{{userId}}/deposit",
          "host": [
            "{{baseUrl}}"
          ],
          "protocol": "http",
          "path": [
            "billing",
            "{{userId}}",
            "deposit"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": {{depositAmount}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const base = 'http://' + (pm.environment.get('baseUrl') || pm.collectionVariables.get('baseUrl'));",
              "const uid = pm.collectionVariables.get('userId');",
              "let attempts = 0;",
              "const maxAttempts = 15;",
              "",
              "function waitForBilling() {",
              "    attempts++;",
              "    pm.sendRequest(`${base}/billing/${uid}`, function (err, res) {",
              "        if (!err && res.code === 200) {",
              "            console.log(`Billing account ready after ${attempts} attempt(s)`);",
              "            return;",
              "        }",
              "        if (attempts < maxAttempts) {",
              "            setTimeout(waitForBilling, 400);",
              "        } else {",
              "            console.warn('Billing account was not ready before deposit request');",
              "        }",
              "    });",
              "}",
              "waitForBilling();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('2. Deposit successful: HTTP 200', function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.test('2. Balance is 1000', function () {",
              "    pm.expect(Number(j.balance)).to.eql(Number(pm.collectionVariables.get('depositAmount')));",
              "});",
              "pm.test('2. Billing account belongs to created user', function () {",
              "    pm.expect(String(j.userId)).to.eql(pm.collectionVariables.get('userId'));",
              "});"
            ]
          }
        }
      ]
    },
