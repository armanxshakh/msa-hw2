{
  "info": {
    "_postman_id": "6dcf8912-7d43-4c3c-9ac6-6f6f2788a801",
    "name": "HW8 - Stream Processing",
    "description": "HW8 Stream Processing: register -> billing via Kafka -> deposit -> successful order -> balance decreased -> success notification -> failed order -> balance unchanged -> failure notification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
