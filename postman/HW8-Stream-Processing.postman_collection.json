    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "successOrderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "failedOrderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "initialDeposit",
      "value": "1000",
      "type": "string"
    },
    {
      "key": "successPrice",
      "value": "300",
      "type": "string"
    },
    {
      "key": "expectedBalance",
